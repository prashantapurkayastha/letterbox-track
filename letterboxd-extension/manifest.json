{
  "manifest_version": 3,
  "name": "Letterboxd Logger",
  "version": "1.3.2",
  "description": "Log movies from Netflix, MUBI, Prime Video and JioHotstar to Letterboxd in one click.",
  "permissions": [
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://mubi.com/*",
    "https://www.primevideo.com/*",
    "https://letterboxd.com/*",
    "https://api.letterboxd.com/*",
    "https://www.hotstar.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/watch/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mubi.com/*/films/*/player",
        "https://mubi.com/*/films/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.primevideo.com/*/detail/*",
        "https://www.primevideo.com/detail/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hotstar.com/*/movies/*",
        "https://www.hotstar.com/*/watch/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}